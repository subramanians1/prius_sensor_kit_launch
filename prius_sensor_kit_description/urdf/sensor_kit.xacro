<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
    <xacro:include filename="$(find vls_description)/urdf/VLS-128.urdf.xacro"/>
    <xacro:include filename="$(find ouster_description)/urdf/OS1-128.urdf.xacro"/>
    <xacro:include filename="$(find camera_description)/urdf/monocular_camera.xacro"/>
    <xacro:include filename="$(find oxts_ins)/urdf/OxTS.xacro"/>
    <xacro:include filename="$(find radar_description)/urdf/radar.xacro"/>
    <!-- <xacro:include filename="$(find oxts_ins)/urdf/small_core.urdf.xml"/> -->

    <xacro:arg name="gpu" default="false"/>
    <xacro:arg name="config_dir" default="$(find prius_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- sensor -->
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- lidar -->    
    <xacro:OS1-128 parent="sensor_kit_base_link" name="os_sensor" topic_points="/points_raw" hz="20" samples="220">
      <origin
        xyz="${calibration['sensor_kit_base_link']['os1_top_base_link']['x']}
             ${calibration['sensor_kit_base_link']['os1_top_base_link']['y']}
             ${calibration['sensor_kit_base_link']['os1_top_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['os1_top_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['os1_top_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['os1_top_base_link']['yaw']}"
      />
    </xacro:OS1-128> 

    <!-- INS -->
    <xacro:OxTS
      name="navsat"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['gnss_link']['x']}"
      y="${calibration['sensor_kit_base_link']['gnss_link']['y']}"
      z="${calibration['sensor_kit_base_link']['gnss_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['gnss_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['gnss_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['gnss_link']['yaw']}"
      fps="100"
    />  
    <xacro:OxTS
      parent="sensor_kit_base_link"
      name="imu"
      namespace="" 
      fps="100"
      x="${calibration['sensor_kit_base_link']['imu_link']['x']}"
      y="${calibration['sensor_kit_base_link']['imu_link']['y']}"
      z="${calibration['sensor_kit_base_link']['imu_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['imu_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['imu_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['imu_link']['yaw']}"  
    /> 

    <!-- Right Camera -->    
    <xacro:monocular_camera_macro
      name="camera0/camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['camera0/camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['camera0/camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['camera0/camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['camera0/camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['camera0/camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['camera0/camera_link']['yaw']}"
      fps="30"
      width="1920"
      height="1200"
      fov="1.3"
    />

    <!-- Left Camera -->    
    <xacro:monocular_camera_macro
      name="camera1/camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['camera1/camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['camera1/camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['camera1/camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['camera1/camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['camera1/camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['camera1/camera_link']['yaw']}"
      fps="30"
      width="1920"
      height="1200"
      fov="1.3"
    />

    <!-- radar -->
    <xacro:radar_macro
      name="radar_front_link"
      parent="sensor_kit_base_link"
      x="${calibration['sensor_kit_base_link']['radar_front_link']['x']}"
      y="${calibration['sensor_kit_base_link']['radar_front_link']['y']}"
      z="${calibration['sensor_kit_base_link']['radar_front_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['radar_front_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['radar_front_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['radar_front_link']['yaw']}"
    />
    <xacro:radar_macro
      name="radar_left_link"
      parent="sensor_kit_base_link"
      x="${calibration['sensor_kit_base_link']['radar_left_link']['x']}"
      y="${calibration['sensor_kit_base_link']['radar_left_link']['y']}"
      z="${calibration['sensor_kit_base_link']['radar_left_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['radar_left_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['radar_left_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['radar_left_link']['yaw']}"
    />
    <xacro:radar_macro
      name="radar_rear_link"
      parent="sensor_kit_base_link"
      x="${calibration['sensor_kit_base_link']['radar_rear_link']['x']}"
      y="${calibration['sensor_kit_base_link']['radar_rear_link']['y']}"
      z="${calibration['sensor_kit_base_link']['radar_rear_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['radar_rear_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['radar_rear_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['radar_rear_link']['yaw']}"
    />
    <xacro:radar_macro
      name="radar_right_link"
      parent="sensor_kit_base_link"
      x="${calibration['sensor_kit_base_link']['radar_right_link']['x']}"
      y="${calibration['sensor_kit_base_link']['radar_right_link']['y']}"
      z="${calibration['sensor_kit_base_link']['radar_right_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['radar_right_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['radar_right_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['radar_right_link']['yaw']}"
    />
    
    
    
  </xacro:macro>
</robot>
