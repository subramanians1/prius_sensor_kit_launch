<launch>
    <!-- Params -->
    <arg name="launch_driver" default="true" description="Whether to connect to a real sensor (true) or to accept packet messages (false).">
        <choice value="true" />
        <choice value="false" />
    </arg>
    <arg name="sensor_model" default="ARS548"/>
    <arg name="config_file" default="$(find-pkg-share nebula_ros)/config/radar/continental/$(var sensor_model).param.yaml"/>
    <arg name="odometry_topic" default="odometry_input"/>
    <arg name="acceleration_topic" default="acceleration_input"/>
    <arg name="steering_angle_topic" default="steering_angle_input"/>
    <arg name="pipeline_type" default="pointcloud" description="Choice of radar pre-processing pipeline. Possible choices: pointcloud, tracks, both">
        <choice value="pointcloud"/>
        <choice value="tracks"/>
        <choice value="both"/>
    </arg>
    
    <!-- Launch appropriate node container -->
    <group if="$(eval &quot;'$(var pipeline_type)'=='tracks'&quot;)">
        <push-ros-namespace namespace="tracks"/>
        <include file="$(find-pkg-share prius_common_sensor_launch)/launch/nebula_radar_tracks_container.launch.py">
            <arg name="config_file" value="$(var config_file)"/>
            <arg name="sensor_model" value="ARS548"/>
            <arg name="launch_hw" value="$(var launch_driver)"/>
            <arg name="odometry_topic" value="$(var odometry_topic)"/>
            <arg name="acceleration_topic" value="$(var acceleration_topic)"/>
            <arg name="steering_angle_topic" value="$(var steering_angle_topic)"/>
        </include>
        
    </group>
    <!-- <arg name="pcd2_message_converter_param_path"
        default="$(find-pkg-share prius_common_sensor_launch)/config/radar_scan_to_pointcloud2.param.yaml"/>

        <node pkg="radar_scan_to_xyzirc_pointcloud2"
            exec="radar_scan_to_xyzirc_pointcloud2_node"
            name="pcd2_message_converter">

  <param from="$(var pcd2_message_converter_param_path)" />

        <remap from="~/input/radar" to="scan_raw"/>
        <remap from="~/output/amplitude_pointcloud" to="pointcloud_from_tracks"/>
        <remap from="~/output/doppler_pointcloud" to="doppler_pointcloud"/>

        </node> -->
    <group if="$(eval &quot;'$(var pipeline_type)'=='pointcloud'&quot;)">
        <push-ros-namespace namespace="pointcloud"/>
        <include file="$(find-pkg-share prius_common_sensor_launch)/launch/nebula_radar_container.launch.py">
            <arg name="config_file" value="$(var config_file)"/>
            <arg name="sensor_model" value="ARS548"/>
            <arg name="launch_hw" value="$(var launch_driver)"/>
            <arg name="odometry_topic" value="$(var odometry_topic)"/>
            <arg name="acceleration_topic" value="$(var acceleration_topic)"/>
            <arg name="steering_angle_topic" value="$(var steering_angle_topic)"/>
        </include>
    </group>
</launch>