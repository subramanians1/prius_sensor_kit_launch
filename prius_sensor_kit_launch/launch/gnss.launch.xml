<launch>
  <arg name="launch_driver" default="true"/>
  <!--<arg name="gnss_receiver" default="ublox" description="ublox(default) or septentrio"/>-->

  <group>
    <push-ros-namespace namespace="imu"/> 

    <!-- INS Sensor Driver -->
    <include file="$(find-pkg-share oxts)/launch/run.py">
      <arg name="unit_ip" value="192.168.2.50"/>
      <arg name="topic_prefix" value="oxts"/>
      <arg name="frame_id" value="imu_link"/>
    </include>  

    <!-- IMU corrector -->

    <include file="$(find-pkg-share autoware_imu_corrector)/launch/imu_corrector.launch.xml">
      <arg name="input_topic" value="$(var topic_prefix)/imu"/>
      <arg name="output_topic" value="imu_data"/>
      <arg name="param_file" value="$(find-pkg-share individual_params)/config/default/prius_sensor_kit/imu_corrector.param.yaml"/>
    </include>
    
    <include file="$(find-pkg-share autoware_imu_corrector)/launch/gyro_bias_estimator.launch.xml">
      <arg name="input_imu_raw" value="$(var topic_prefix)/imu"/>
      <arg name="input_odom" value="/localization/kinematic_state"/>
      <!-- <arg name="input_odom" value="$(var topic_prefix)/odometry"/> -->
      <arg name="imu_corrector_param_file" value="$(find-pkg-share individual_params)/config/default/prius_sensor_kit/imu_corrector.param.yaml"/> 
    </include>
    
    
    <!-- NavSatFix to MGRS Pose -->
    <include file="$(find-pkg-share autoware_gnss_poser)/launch/gnss_poser.launch.xml">
      <arg name="input_topic_fix" value="$(var topic_prefix)/nav_sat_fix"/>
      <arg name="input_topic_orientation" value="/orientation/path"/>

      <arg name="output_topic_gnss_pose" value="pose"/>
      <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      <arg name="output_topic_gnss_fixed" value="fixed"/>

      <arg name="gnss_base_frame" value="navsat_base_link"/>

      <arg name="param_file" value="$(find-pkg-share autoware_gnss_poser)/config/gnss_poser.param.yaml"/>

    </include>
     
    <!--
    <remap from ="gyro_bias" to="/imu/gyro_bias"/> 
    <remap from ="imu_data" to="/imu/imu_data"/> 
    -->
    
  </group>

  
</launch>
