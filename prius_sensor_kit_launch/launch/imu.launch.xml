<launch>
  <arg name="launch_driver" default="true"/>

  <!-- INS Sensor Driver -->
  <include file="$(find-pkg-share oxts)/launch/run.py">
    <arg name="unit_ip" value="192.168.2.50"/>
    <arg name="topic_prefix" value="oxts"/>
    <arg name="frame_id" value="imu_link"/>
  </include> 

  <!-- Switch topic name -->
    <let name="imu_topic_name" value="/sensing/$(var topic_prefix)/imu"/>

  <group>
    <push-ros-namespace namespace="imu"/>

    <arg name="imu_corrector_param_file" default="$(find-pkg-share individual_params)/config/$(var vehicle_id)/prius_sensor_kit/imu_corrector.param.yaml"/>

    <include file="$(find-pkg-share autoware_imu_corrector)/launch/imu_corrector.launch.xml">
      <arg name="input_topic" value="$(var imu_topic_name)"/>
      <arg name="output_topic" value="imu_data"/>
      <arg name="param_file" value="$(var imu_corrector_param_file)"/>
    </include>
    
    <include file="$(find-pkg-share autoware_imu_corrector)/launch/gyro_bias_estimator.launch.xml">
      <arg name="input_imu_raw" value="$(var imu_topic_name)"/>
      <arg name="input_odom" value="/localization/kinematic_state"/>
      <arg name="output_gyro_bias" value="gyro_bias"/>
      <arg name="imu_corrector_param_file" value="$(var imu_corrector_param_file)"/> 
    </include>

  </group>
</launch>
